{
  "info": {
    "name": "七牛云图片上传 API",
    "description": "七牛云图片上传功能的 API 测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Single Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/single",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "single"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload Multiple Images",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/multiple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "multiple"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Upload Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"optional-custom-key\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/upload/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Single Image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://t6mfwj8xf.hn-bkt.clouddn.com/uploads/xxx.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/upload/single",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "single"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Multiple Images",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"http://t6mfwj8xf.hn-bkt.clouddn.com/uploads/xxx1.jpg\",\n    \"http://t6mfwj8xf.hn-bkt.clouddn.com/uploads/xxx2.jpg\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/upload/multiple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "multiple"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Get All Recommendations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Recommendation with Images",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "GitHub",
                  "type": "text"
                },
                {
                  "key": "url",
                  "value": "https://github.com",
                  "type": "text"
                },
                {
                  "key": "icon",
                  "value": "🐙",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Development",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Code hosting platform",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Recommendation with Images",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Updated Title",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/recommendations/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "recommendation-id"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Recommendation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "recommendation-id"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
